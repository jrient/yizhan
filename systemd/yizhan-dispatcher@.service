[Unit]
Description=驿站 dispatcher (%i):取卡并唤起 claude

[Service]
Type=oneshot
ExecStart={repo}/.venv/bin/python -m gateway.dispatcher %i
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# 必须和 gateway/dispatcher.py 的 UNIT_TIMEOUT_S 一致(有测试锁住)
TimeoutStartSec=14400
